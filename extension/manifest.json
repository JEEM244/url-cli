{
  "manifest_version": 3,
  "name": "TabVault",
  "version": "0.4.0",
  "description": "Guarda, restaura y convierte sesiones en carteleras HTML.",
  "permissions": ["tabs", "tabGroups"],
  "action": {
    "default_title": "TabVault",
    "default_popup": "popup.html"
  },
  "incognito": "spanning"
}